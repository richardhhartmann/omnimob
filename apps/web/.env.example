# ─── Omnimob web — modelo do .env de DESENVOLVIMENTO ────────────────────────
#
# Copie para `.env`. TUDO aqui vai para o bundle do navegador: nada de segredo.

# A API. Sem barra no fim.
VITE_API_URL=http://localhost:4000

# Cloudinary — os MESMOS valores do .env da API.
VITE_CLOUDINARY_CLOUD_NAME=dpwuxmbli
VITE_CLOUDINARY_UPLOAD_PRESET=domus-app

# Chave PUBLICÁVEL de teste do Stripe.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Vitrine em `<slug>.omnimob.app` em vez de `omnimob.app/vitrine/<slug>`. Fica
# "false" até o domínio curinga existir na Vercel — ver utils/enderecoVitrine.js.
VITE_VITRINE_SUBDOMINIO=false

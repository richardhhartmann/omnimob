# ─── Omnimob API — modelo do .env de DESENVOLVIMENTO ────────────────────────
#
# Copie para `.env` e preencha. Este arquivo entra no repositório; o `.env` não.
# Valor em branco = opcional. O que cada variável faz e o valor de PRODUÇÃO
# estão na tabela "Env vars" do CLAUDE.md — o resumo aqui é o suficiente para
# subir a API local.
#
# A regra que evita a maior parte dos enganos: metade destas variáveis aponta
# para a API (localhost:4000) e a outra metade para o FRONT (localhost:5173).
# Trocar as duas coisas quebra no CORS ou manda o link do e-mail para um 404.

# ── Banco ────────────────────────────────────────────────────────────────────
# Pooler do Supabase de dev (:6543, pgbouncer) e a conexão direta (:5432, para
# migrations).
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres

# O banco da PLATAFORMA: onde vivem os super-admins e os cargos deles. As
# pessoas da Omnimob são as mesmas em dev e em produção, então em dev isto
# aponta para o banco de PRODUÇÃO — de preferência com o role restrito
# `omnimob_plataforma` (ver docs/plataforma-role.sql), que só alcança as três
# tabelas do super-admin. Em produção fica VAZIA (é o próprio banco).
# Ver "Sobre o banco da PLATAFORMA" no CLAUDE.md.
PLATAFORMA_DATABASE_URL=

# ── Servidor e segredos ──────────────────────────────────────────────────────
PORT=4000
# Qualquer string em dev. Em produção: forte, e DIFERENTE do CRYPTO_SECRET.
JWT_SECRET=omnimob-dev-secret
# Cifra o token da página do Meta em repouso. Opcional em dev (cai no JWT_SECRET).
CRYPTO_SECRET=

# ── Endereços (FRONT) ────────────────────────────────────────────────────────
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Meta (Facebook/Instagram) ────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Aponta para a API.
META_CALLBACK_URL=http://localhost:4000/api/social/oauth/callback

# ── Mercado Livre (opcional; sem elas o canal aparece indisponível) ──────────
MERCADOLIVRE_APP_ID=
MERCADOLIVRE_APP_SECRET=
MERCADOLIVRE_CALLBACK_URL=http://localhost:4000/api/canais/mercadolivre/callback

# ── Mercado Pago (Pix do plano; opcional em dev) ─────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Vazio em dev: localhost não recebe aviso.
MERCADOPAGO_WEBHOOK_URL=

# ── Google (opcional; sem ela o "entrar com Google" some) ────────────────────
GOOGLE_CLIENT_ID=

# ── IA (Google AI Studio) ────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Stripe (chaves e preços de TESTE) ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PREMIUM=price_...
# Anuais (opcionais — sem eles o alternador some da landing, sem erro).
STRIPE_PRICE_BASICO_ANUAL=
STRIPE_PRICE_PROFISSIONAL_ANUAL=
STRIPE_PRICE_PREMIUM_ANUAL=
# Pacote Hub+Flow (opcionais — ainda não existem no Stripe; ver CLAUDE.md).
STRIPE_PRICE_BASICO_FLOW=
STRIPE_PRICE_PROFISSIONAL_FLOW=
STRIPE_PRICE_PREMIUM_FLOW=
STRIPE_PRICE_BASICO_FLOW_ANUAL=
STRIPE_PRICE_PROFISSIONAL_FLOW_ANUAL=
STRIPE_PRICE_PREMIUM_FLOW_ANUAL=

# ── E-mail ───────────────────────────────────────────────────────────────────
# Vazio em dev: o link do e-mail só vai para o log, e nada é enviado. É o
# único transporte que funciona no Render; o SMTP abaixo é fallback local.
RESEND_API_KEY=
EMAIL_REMETENTE=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Destino do formulário de contato da landing.
CONTATO_EMAIL=

# ── Cloudinary (os MESMOS valores dos VITE_ do web) ──────────────────────────
CLOUDINARY_CLOUD_NAME=dpwuxmbli
CLOUDINARY_UPLOAD_PRESET=domus-app

# ── Vercel (domínio próprio e subdomínio de vitrine; opcional em dev) ───────
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ── Agendadores (só com UMA instância; tudo desligado em dev) ────────────────
FAXINA_AUTOMATICA=false
AVISO_VENCIMENTO_AUTOMATICO=false
LEADS_PARADOS_AUTOMATICO=false
SINCRONIZACAO_AUTOMATICA=false

# ── Demonstração ─────────────────────────────────────────────────────────────
# A imobiliária que o "Ver por dentro" da landing abre (POST /api/auth/demo):
# sessão do Administrador dela, somente leitura, 45 min, tour obrigatório.
# `npm run demonstracao` cria/atualiza essa imobiliária (a imobiliaria-centro
# do seed com fotos de imóvel de verdade) no banco do ambiente — rode em dev e
# em produção. Vazio = o botão da landing leva a "demonstração indisponível".
DEMO_TENANT_SLUG=demonstracao

# ── Seed ─────────────────────────────────────────────────────────────────────
# Só o `npm run prisma:seed` lê. Com PLATAFORMA_DATABASE_URL apontando para
# fora, o seed PULA o super-admin — estas três só valem para banco local.
SEED_DEV=true
SUPER_ADMIN_EMAIL=super@omnimob.app
SUPER_ADMIN_NOME=Super Admin
SUPER_ADMIN_PASSWORD=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum PropertyStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum PublicationChannel {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  MERCADO_LIVRE
}

enum PublicationStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum MetricEventType {
  VIEW
  LEAD
  SALE
}

enum TipoVenda {
  VENDA
  ALUGUEL
}

enum AndamentoImovel {
  PRONTO_PARA_MORAR
  EM_CONSTRUCAO
}

// Natureza do negócio do imóvel. Cada tenant escolhe quais tipos ficam
// disponíveis no cadastro (Tenant.tiposContrato).
enum TipoContrato {
  VENDA // transferência de propriedade
  LOCACAO // aluguel
  PERMUTA // troca de bens
  BUILT_TO_SUIT // construção sob medida para locação comercial
}

/**
 * Estágio do lead no atendimento.
 * A ordem da lista é a ordem do funil, e o código conta com isso em um lugar
 * só: o relatório que empilha os estágios. GANHO e PERDIDO são os dois fins
 * possíveis — sair do funil por cima ou por baixo.
 */
enum LeadEstagio {
  NOVO
  EM_ATENDIMENTO
  VISITA
  PROPOSTA
  GANHO
  PERDIDO
}

enum LeadEventoTipo {
  CRIADO
  ESTAGIO
  RESPONSAVEL
  NOTA
  CONTATO
}

enum StatusPagamento {
  TRIAL
  EM_DIA
  ATRASADO
  CANCELADO
}

// ─── Tenant ──────────────────────────────────────────────────────────────────

model Tenant {
  id                  String          @id @default(cuid())
  name                String
  slug                String          @unique
  cnpj                String?
  creci               String?
  whatsapp            String          @default("")
  telefone            String          @default("")
  email               String          @default("")
  description         String          @default("")
  slogan              String          @default("")
  logoUrl             String          @default("")
  /**
   * ── CORES DO PAINEL ────────────────────────────────────────────────────
   * `primaryColor` e `secondaryColor` eram uma coisa só, usada no painel E na
   * vitrine — e as duas respondem a perguntas diferentes. O painel é ferramenta
   * de trabalho da equipe; a vitrine é a cara da imobiliária para o cliente
   * dela. Uma imobiliária pode querer o painel sóbrio e a vitrine vibrante, e
   * antes isso era impossível sem estragar um dos dois.
   * Estes dois continuam sendo os do PAINEL — manter o nome evita reescrever
   * todo o painel e o schema de uma vez. As cores da vitrine moram no
   * `showcaseConfig`, junto do resto do desenho dela.
   */
  primaryColor        String          @default("#6366f1")
  secondaryColor      String          @default("#d4af37")
  /**
   * Tema do painel para toda a imobiliária: "escuro" | "claro" | "auto".
   * É o PADRÃO, não uma imposição: vale para quem ainda não escolheu o seu.
   * Ver `Usuario.temaPainel` — se o da pessoa for nulo, este é aplicado.
   * "auto" espelha o sistema operacional de quem está olhando.
   */
  temaImobiliaria     String          @default("escuro") @map("tema_imobiliaria")
  showcaseHeadline    String          @default("")
  showcaseSubheadline String          @default("")
  cep                 String?
  endereco            String          @default("")
  cidade              String          @default("")
  estado              String          @default("")
  /**
   * Horário de atendimento, como uma lista de faixas:
   * `[{ dias: "Segunda a sexta", abre: "09:00", fecha: "18:00", fechado: false }]`
   * JSON e não colunas por dia da semana: imobiliária de plantão em fim de
   * semana, atendimento partido no almoço e "sábado só com hora marcada" são
   * a norma, e sete pares de colunas não descrevem nenhum dos três. O widget
   * de Horários escrevia isso como HTML solto no `content`, o que dava um
   * texto bonito e um dado que ninguém mais no sistema conseguia ler.
   * Nulo = nunca foi preenchido, e o widget cai no texto manual.
   */
  horarioAtendimento  Json?           @map("horario_atendimento")
  /**
   * Ano em que a imobiliária foi fundada — dela, não da conta aqui.
   * O widget "Números" precisava dizer "X anos de experiência", e a única data
   * que tínhamos era `createdAt`, a da assinatura da Omnimob. Uma imobiliária
   * de trinta anos que entrou no mês passado anunciaria "0 anos" na própria
   * vitrine — um número pior que nenhum. Nulo enquanto ninguém preencher, e o
   * cartão simplesmente não aparece.
   */
  fundadaEm           Int?            @map("fundada_em")
  showcaseConfig      Json?
  chavesApi           ChaveApi[]
  fontesImportacao    FonteImportacao[]
  webhooks            Webhook[]
  facebookPageId      String?
  facebookPageToken   String?
  facebookPageName    String?
  instagramBusinessId String?
  /**
   * ── Mercado Livre ────────────────────────────────────────────────────────
   * Ao contrário do ZAP e do OLX, que vêm BUSCAR o feed, o Mercado Livre é
   * empurrado: publicamos cada anúncio pela API deles, em nome do vendedor.
   * Daí precisar de token por imobiliária, e não de uma credencial nossa.
   * O token vale seis horas e o `refresh` renova — guardamos os dois cifrados
   * (`services/cofre.js`), como o token da página do Facebook.
   * Publicar exige ainda um PACOTE DE ANÚNCIOS contratado pelo vendedor com o
   * comercial do Mercado Livre. Sem ele a API autentica e recusa a publicação,
   * e é por isso que a tela avisa antes de a pessoa tentar.
   */
  mercadoLivreUserId   String?   @map("ml_user_id")
  mercadoLivreToken    String?   @map("ml_token")
  mercadoLivreRefresh  String?   @map("ml_refresh")
  mercadoLivreExpiraEm DateTime? @map("ml_expira_em")
  mercadoLivreNick     String?   @map("ml_nick")
  /**
   * ── Ponte não oficial de WhatsApp ────────────────────────────────────────
   * NÃO é integração nossa com a Meta: é o endereço de um serviço que a própria
   * imobiliária contrata (Whapi, Evolution API e afins), que mantém uma sessão
   * do WhatsApp Web e publica status por ela.
   * Guardamos o endereço e o token, não a sessão — de propósito. Hospedar a
   * sessão faria a Omnimob operar a violação dos termos da Meta em nome do
   * cliente; assim a decisão, o risco e o contrato são de quem liga.
   * A tela deixa explícito que isso pode banir o número.
   */
  whatsappPonteUrl   String? @map("wa_ponte_url")
  whatsappPonteToken String? @map("wa_ponte_token")
  /**
   * Quem recebe o status publicado pela ponte.
   *
   * Vazio significa TODOS OS CONTATOS, e não é escolha nossa: a documentação do
   * Whapi diz que sem o campo `contacts` ele busca a agenda inteira e manda para
   * todo mundo. Foi assim que um anúncio de teste apareceu para a lista de
   * contatos completa de quem estava só experimentando.
   *
   * A privacidade configurada NO APARELHO não vale aqui. A ponte é uma sessão
   * vinculada e publica com a lista dela — então a única forma de restringir o
   * público é esta, e ela precisa estar na tela, não enterrada na configuração.
   *
   * Guardado como número puro (só dígitos, com DDI); o sufixo que a API exige
   * é montado na hora do envio.
   */
  whatsappPonteContatos String[] @default([]) @map("wa_ponte_contatos")
  /**
   * Quando um portal veio buscar o feed pela última vez.
   * É a única evidência que a imobiliária tem de que a integração com o ZAP
   * está viva — nós não recebemos confirmação de carga, e "cadastrei a URL, e
   * agora?" era uma pergunta sem resposta possível.
   */
  feedLidoEm         DateTime? @map("feed_lido_em")
  ativo               Boolean         @default(true)
  /**
   * QUANDO o acesso foi cortado — e é daqui que o prazo de remoção conta.
   *
   * Contava de `proximoVencimento`, e havia um buraco sério nisso: o aviso de
   * vencimento só sai quando a faxina roda. Enquanto ela não rodava (ela é
   * opt-in, `FAXINA_AUTOMATICA`), o relógio da remoção corria mesmo sem
   * ninguém ter sido avisado. Uma conta parada há 31 dias recebia o e-mail
   * dizendo "seus dados ficam guardados por 30 dias" e era APAGADA na mesma
   * rodada, um instante depois.
   *
   * Com a marca aqui, o prazo começa quando o acesso realmente acaba. A faxina
   * que desativa nunca é a que remove.
   *
   * Nulo em conta ativa, e também nas que já estavam desativadas antes desta
   * coluna existir — para essas o `proximoVencimento` segue valendo, que é o
   * prazo que elas foram avisadas.
   */
  suspensoEm          DateTime?       @map("tnt_suspenso_em")
  plano               String? // BASICO | PROFISSIONAL | PREMIUM (null = BASICO)
  autoGerarIA         Boolean         @default(true) // auto-preenche imóvel por IA ao lançar foto

  /**
   * ─── Publicação automática por canal ───────────────────────────────────────
   *
   * `{ portais: bool, mercadoLivre: bool, facebook: bool, instagram: bool }`.
   *
   * Ligado um canal, todo imóvel novo sai por ele sem ninguém apertar nada — e
   * a tela de divulgação deixa de oferecer o botão, porque não há o que
   * decidir. É a diferença entre uma ferramenta e uma esteira: quem liga isto
   * está dizendo "não me pergunte mais".
   *
   * JSON e não uma coluna por canal: canal novo entra sem migração, e a lista
   * de canais já muda sozinha conforme o que a imobiliária conectou. O preço é
   * não ter integridade no banco — aceitável para uma preferência de interface,
   * inaceitável para qualquer coisa que decida cobrança.
   *
   * Recurso de plano PROFISSIONAL para cima. No Básico o campo até existe, mas
   * a tela não o oferece e o servidor o ignora.
   */
  publicacaoAutomatica Json?     @map("tnt_publicacao_automatica")

  /* Os atalhos padrão da imobiliária, definidos pelo administrador. A pessoa
   * ainda pode discordar em `Usuario.atalhos` — a casa estabelece a convenção,
   * quem trabalha o dia inteiro na ferramenta pode ter outra. */
  atalhos              Json?     @map("tnt_atalhos")

  /* O interruptor mestre. Desligado, nenhuma tecla funciona e nenhum selo é
   * desenhado ao lado dos botões — a imobiliária que não quer atalhos não quer
   * nem o ruído visual deles.
   *
   * Nasce LIGADO: o recurso existe para ser usado, e quem não gostar desliga
   * numa caixa. Nascer desligado esconderia o recurso de quem nunca vai
   * procurá-lo em Configurações. */
  atalhosAtivos        Boolean   @default(true) @map("tnt_atalhos_ativos")
  /**
   * Marca d'água nas fotos de imóvel.
   * Ligada por padrão porque só tem efeito para quem TEM logo: sem logo
   * configurada, o cadastro nem chama a composição. Deixar desligada por padrão
   * esconderia o recurso de quem mais se beneficia dele — a imobiliária que
   * acabou de subir a própria marca.
   * A opacidade é guardada em PORCENTAGEM inteira, e não em fração: é o número
   * que aparece no painel ("55%") e o que a pessoa escolhe no controle. Guardar
   * 0.55 obrigaria a converter nos dois sentidos, em dois lugares, para nunca
   * mostrar o valor cru.
   */
  marcaDaguaAtiva     Boolean         @default(true) @map("tnt_marca_dagua_ativa")
  marcaDaguaOpacidade Int             @default(55) @map("tnt_marca_dagua_opacidade")
  // Tipos de contrato liberados no cadastro de imóvel desta imobiliária.
  // Lista vazia = nenhum parametrizado; a UI trata como "todos" para não travar o cadastro.
  tiposContrato       TipoContrato[]  @default([VENDA, LOCACAO, PERMUTA, BUILT_TO_SUIT]) @map("tipos_contrato")
  statusPagamento     StatusPagamento @default(TRIAL)
  proximoVencimento   DateTime?
  valorMensal         Decimal?        @db.Decimal(10, 2)

  /**
   * ─── Endereço da vitrine ──────────────────────────────────────────────────
   * Enquanto `dominioProprio` for nulo, a vitrine vive no endereço da Omnimob
   * e nada aqui importa. Quando a imobiliária traz o domínio dela, guardamos:
   * dominioProprio  o host pedido, sem protocolo nem barra ("imob.com.br")
   * dominioStatus   PENDENTE enquanto o DNS não aponta; ATIVO depois
   * dominioAlvo     o que a Vercel mandou o cliente cadastrar no registrador
   * `dominioAlvo` é gravado porque o valor NÃO é fixo: a Vercel devolve um alvo
   * por projeto (hoje um CNAME `<hash>.vercel-dns-017.com`) e já trocou o IP do
   * apex uma vez. Cravar no código quebraria calado no dia da próxima troca —
   * e o sintoma seria "o domínio do cliente parou", sem pista.
   */
  dominioProprio      String?   @unique @map("tnt_dominio_proprio")
  dominioStatus       String    @default("OMNIMOB") @map("tnt_dominio_status")
  dominioAlvo         Json?     @map("tnt_dominio_alvo")
  dominioVerificadoEm DateTime? @map("tnt_dominio_verificado_em")

  /**
   * O que a imobiliária disse, ao pedir o teste, que traria de outro sistema:
   * `{ sistemaAtual, itens, volume, formato, observacao }`. Nulo para quem
   * está abrindo agora e não tem nada para trazer.
   * Precisa ficar aqui, e não só no e-mail que o time recebe, porque quem
   * responde a ela é o PRIMEIRO ACESSO: a pessoa marcou "imóveis e clientes"
   * num modal na landing e, dias depois, entra no painel — o convite que
   * carregava essa informação já foi consumido. Sem gravar, o boas-vindas não
   * teria como saber que ela veio para migrar.
   * `migracaoResolvidaEm` marca que o assunto já foi tratado (ela importou, ou
   * disse que faz depois). Um carimbo em vez de apagar a intenção: o que ela
   * pretendia trazer continua sendo informação útil para o time de vendas.
   */
  migracaoIntencao    Json?     @map("tnt_migracao_intencao")
  migracaoResolvidaEm DateTime? @map("tnt_migracao_resolvida_em")

  /**
   * Quando a imobiliária ganhou o prazo extra de teste, pela pesquisa que
   * aparece no painel (ver `PesquisaTrial`). Coluna própria, e não uma conta
   * em cima do histórico de respostas, porque é ela que impede o segundo
   * esticão: a guarda vira um UPDATE condicional (`trialEstendidoEm: null`),
   * que o Postgres serializa sozinho. Contar linhas de log deixaria dois
   * cliques simultâneos passarem juntos e darem 14 dias de graça.
   */
  trialEstendidoEm DateTime? @map("tnt_trial_estendido_em")

  /**
   * ─── A ASSINATURA NO PROVEDOR ──────────────────────────────────────────────
   *
   * O id da subscription no Stripe. Sem ele não dá para MEXER numa assinatura
   * viva — trocar de plano ou contratar o Flow no meio do ciclo exige apontar
   * para o objeto lá dentro, e até aqui o produto não sabia qual era: as duas
   * rotas respondiam `cobrancaAjustada: false` e o valor era acertado à mão.
   *
   * ── E POR QUE UMA COLUNA, SE JÁ HÁ A BUSCA POR METADATA ──
   *
   * `cobrancaEmAberto` acha a assinatura por `metadata.tenantId` e o comentário
   * de lá argumenta contra esta coluna — "mais uma coisa para sair de sincronia
   * com a verdade, que mora lá". O argumento continua valendo para LEITURA.
   *
   * Para ESCRITA ele não basta, por dois motivos: o índice de busca do Stripe é
   * eventualmente consistente (a documentação fala em até um minuto de atraso),
   * e uma assinatura recém-criada pode simplesmente não aparecer; e a busca é
   * uma chamada de rede a mais no caminho de uma operação que já faz duas.
   *
   * O arranjo usa os dois: a coluna é o caminho rápido, a busca é o resgate
   * quando ela está vazia — e o resultado da busca é GRAVADO aqui. Ou seja,
   * conta antiga se conserta sozinha no primeiro ajuste. E coluna velha não
   * mente por muito tempo: quem for usá-la lê a assinatura no provedor antes de
   * escrever, então um id morto vira "não achei" e cai na busca.
   */
  assinaturaId String? @map("tnt_assinatura_id")

  /**
   * Quais boas-vindas do painel esta imobiliária já recebeu: "teste" e/ou
   * "assinante" (ver `BoasVindasModal`, no web).
   *
   * Estava no `localStorage`, e o custo aparecia toda vez que alguém entrava de
   * outra máquina, de outro navegador ou de uma janela anônima: o assistente de
   * primeiro acesso voltava do zero — a ficha da imobiliária, o endereço da
   * vitrine, a importação da base — para quem já tinha respondido tudo. Marca de
   * navegador não responde "esta CONTA já foi recebida?", ela responde "este
   * navegador já viu?", que é outra pergunta.
   *
   * Lista e não booleano porque são duas recepções distintas, com mensagens
   * distintas: quem viu as do teste e depois assina precisa ver as de
   * assinante. Lista e não duas colunas porque um terceiro momento (renovou,
   * mudou de plano) entra sem migração.
   */
  boasVindasVistas String[] @default([]) @map("tnt_boas_vindas_vistas")

  /**
   * ─── OS MÓDULOS QUE ESTA IMOBILIÁRIA CONTRATOU ─────────────────────────────
   *
   * O produto deixou de ser uma coisa só. `HUB` é tudo que existia até aqui —
   * acervo, vitrine, leads, equipe, relatórios. `FLOW` é a operação comercial:
   * captação por webhook, funil de negócios, minutas, assinatura digital e
   * comissão.
   *
   * LISTA, e não um booleano `temFlow`. O terceiro módulo é uma string nova
   * aqui e nada mais — enquanto um booleano por módulo vira uma coluna por
   * módulo, e a pergunta "o que esta conta tem?" passa a exigir ler todas.
   *
   * `HUB` sempre presente na prática (é onde o cadastro vive), mas não é
   * imposto pelo banco: uma imobiliária que um dia só use o Flow é um cenário
   * de negócio plausível, e um `@default` que mente sobre isso seria pior que
   * um `@default` que só descreve o começo.
   *
   * Quem contratou é o TENANT; quem alcança é o CARGO (`Cargo.acessarFlow`).
   * As duas perguntas são diferentes e as duas precisam ser sim.
   */
  modulos ModuloOmnimob[] @default([HUB]) @map("tnt_modulos")

  /**
   * Percentual padrão de comissão da imobiliária sobre o valor do negócio, e
   * quanto desse percentual fica com o corretor. Padrões do mercado brasileiro:
   * 6% de comissão, metade para quem vendeu.
   *
   * São PADRÕES, não regra: cada negócio pode ter o seu (ver `Negocio`). Ter os
   * dois aqui é o que faz o cálculo automático ter de onde partir sem obrigar
   * quem cadastra a digitar percentual em todo negócio.
   */
  comissaoPercentual   Decimal @default(6) @map("tnt_comissao_percentual") @db.Decimal(5, 2)
  comissaoCorretorPerc Decimal @default(50) @map("tnt_comissao_corretor_perc") @db.Decimal(5, 2)

  /**
   * Credenciais do provedor de assinatura digital DESTA imobiliária.
   * Cifradas em repouso pelo `services/cofre.js`, como o token da página do
   * Facebook, e filtradas na saída por `SEGREDOS_DO_TENANT`.
   *
   * Por tenant e não global: quem assina o contrato é a imobiliária, em nome
   * dela, com a conta dela na Clicksign ou na DocuSign. Uma credencial nossa
   * faria todo contrato do país sair assinado pela Omnimob.
   */
  assinaturaProvedor String? @map("tnt_assinatura_provedor")
  assinaturaToken    String? @map("tnt_assinatura_token")
  assinaturaConta    String? @map("tnt_assinatura_conta")
  assinaturaSandbox  Boolean @default(true) @map("tnt_assinatura_sandbox")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios     Usuario[]
  cargos       Cargo[]
  tiposImovel  TipoImovel[]
  properties   Property[]
  publications PropertyPublication[]
  leads        PropertyLead[]
  clientes     Cliente[]
  vendas       Venda[]
  chamados     Chamado[]
  pesquisas    PesquisaTrial[]

  auditorias  Auditoria[]
  leadEventos LeadEvento[]
  perfisBusca PerfilBusca[]

  // ─── Omnimob Flow ───
  negocios        Negocio[]
  negocioEventos  NegocioEvento[]
  modelosContrato ModeloContrato[]
  contratos       Contrato[]
  fontesCaptacao  FonteCaptacao[]
  captacaoEventos CaptacaoEvento[]

  @@map("tb_tenants")
}

/**
 * Resposta da pesquisa que aparece sozinha durante o teste, depois de a pessoa
 * cadastrar/editar algo (ver `PulsoTrialModal` no web).
 * É um HISTÓRICO, não um campo no tenant: a mesma imobiliária pode responder
 * mais de uma vez ao longo do teste, e a sequência é o que tem valor — quem
 * respondeu "estou com dificuldade" na segunda semana depois de ter dito
 * "estou amando" na primeira é exatamente o contato que precisa ser feito
 * antes do vencimento.
 * Guarda também o fechamento sem resposta (`escolha: "FECHOU"`), porque é ele
 * que segura a cadência entre um dispositivo e outro — sem essa linha, quem
 * dispensa a pergunta no computador do escritório a receberia de novo no
 * celular alguns minutos depois.
 */
model PesquisaTrial {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  // Nome de quem respondeu, copiado no momento da resposta. Sem FK de
  // propósito: se o usuário for removido a resposta continua fazendo sentido,
  // e é o texto que o time lê no e-mail de aviso.
  autor      String   @default("") @map("psq_autor")
  // AMANDO | NEUTRO | DIFICIL — nulo quando fechou sem dizer nada.
  sentimento String?  @map("psq_sentimento")
  // ASSINAR | ESTENDER | DEPOIS | FECHOU
  escolha    String   @map("psq_escolha")
  comentario String   @default("") @map("psq_comentario")
  // Que ação abriu a pergunta ("imovel", "cliente", "vitrine"…). Serve para
  // saber se a pesquisa está caindo em hora boa ou atrapalhando um fluxo.
  origem     String   @default("") @map("psq_origem")
  criadoEm   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, criadoEm])
  @@map("tb_pesquisa_trial")
}

// ─── Super Admin (acesso ao painel da Omnimob, fora dos tenants) ────────────────

model SuperAdmin {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senha     String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tb_super_admin")
}

// ─── Cargo (substitui o enum UserRole) ───────────────────────────────────────

/**
 * Cargo é de UMA imobiliária.
 * Nasceu sem `tenantId`, e por um tempo a tabela foi global: as três
 * imobiliárias do banco dividiam a mesma linha "Administrador", e o
 * `cargoRoutes` listava e editava tudo sem filtro. Tirar "Gerenciar Imóveis" do
 * Corretor numa imobiliária tirava dos corretores das outras — sem aviso, e sem
 * nada na tela que sugerisse que aquele cargo não era só dela.
 * O vínculo é obrigatório de propósito: cargo sem dono é exatamente o estado
 * que produziu o vazamento. `onDelete: Cascade` acompanha o resto do schema —
 * sai a imobiliária, saem os cargos dela.
 */
model Cargo {
  id        Int    @id @default(autoincrement()) @map("crg_codigo")
  tenantId  String @map("tenant_id")
  descricao String @map("crg_descricao")

  // Permissões de acesso
  acessarPainel     Boolean @default(false) @map("acessar_painel")
  editarPagina      Boolean @default(false) @map("editar_pagina")
  gerenciarImoveis  Boolean @default(false) @map("gerenciar_imoveis")
  gerenciarLeads    Boolean @default(false) @map("gerenciar_leads")
  gerenciarUsuarios Boolean @default(false) @map("gerenciar_usuarios")
  gerenciarClientes Boolean @default(false) @map("gerenciar_clientes")
  gerenciarCargos   Boolean @default(false) @map("gerenciar_cargos")
  /**
   * Ver o menu Configurações. Era derivada — o menu saía de
   * `editarPagina || gerenciarUsuarios` — e por isso tirar "Gerenciar Usuários"
   * de um cargo levava junto a aba de Configurações, que não tem relação
   * nenhuma com gerir gente. Agora é permissão própria.
   * Exclusiva do cargo Administrador: a tela nem oferece a caixa para os
   * outros, e a API recusa (ver `cargoRoutes`). Configurações é onde ficam
   * plano, cobrança, domínio e o cancelamento da assinatura.
   */
  verConfiguracoes  Boolean @default(false) @map("ver_configuracoes")
  verRelatorios     Boolean @default(false) @map("ver_relatorios")
  /* Ler a trilha de auditoria — quem criou, alterou e excluiu o quê.
     Exclusiva do Administrador, como `verConfiguracoes` e pelo mesmo motivo: a
     trilha mostra a movimentação de TODO MUNDO, inclusive de quem administra a
     conta. Não é informação de operação, é informação de supervisão. */
  verAuditoria      Boolean @default(false) @map("ver_auditoria")
  publicarRedes     Boolean @default(false) @map("publicar_redes")

  /* O painel do gestor (a tela "/"). Separada de `acessarPainel` porque o que
   * ela mostra é outro nível de informação: faturamento, comissão por corretor
   * e desempenho individual da equipe. Um corretor com acesso ao painel precisa
   * ver os imóveis dele; não precisa ver quanto o colega ganhou.
   *
   * Nasce `false` inclusive para cargos que já existem — dado sensível não pode
   * aparecer para ninguém por efeito colateral de uma migração. */
  verPainelGestor   Boolean @default(false) @map("ver_painel_gestor")

  // ─── Omnimob Flow ──────────────────────────────────────────────────────────
  /**
   * A PORTA do módulo, e o par de `acessarPainel`.
   *
   * `acessarPainel` responde "esta pessoa entra no Hub?"; esta responde "esta
   * pessoa entra no Flow?". As duas independentes de propósito: existe quem só
   * cuide do acervo e da vitrine, quem só trabalhe negócios, e quem faça as
   * duas coisas. O seletor de módulo na barra lateral só aparece para quem tem
   * as duas — sem isso ele ofereceria uma porta que dá em 403.
   *
   * Nasce `false` inclusive para cargos que já existem. A imobiliária contratar
   * o Flow não pode liberar contrato e comissão para a equipe inteira por
   * efeito colateral de uma migração — quem decide é quem administra a conta,
   * cargo por cargo.
   *
   * `acessarPainel` continua sendo forçada em toda gravação (existir como cargo
   * é entrar no Hub); esta NÃO é, e é justamente a diferença.
   */
  acessarFlow       Boolean @default(false) @map("acessar_flow")
  /** Ver e mover negócios no funil. É o trabalho do corretor dentro do Flow. */
  gerenciarNegocios Boolean @default(false) @map("gerenciar_negocios")
  /** Montar minutas, gerar contrato e mandar para assinatura. */
  gerenciarContratos Boolean @default(false) @map("gerenciar_contratos")
  /**
   * As duas flags que TRAVAM o fechamento do negócio.
   *
   * Elas não são "ver a aba jurídica": são o poder de dizer "conferi, está de
   * pé". Nenhuma delas nasce em cargo nenhum, nem no Administrador, e é
   * deliberado — se o Administrador as tivesse por padrão, a trava viraria
   * ornamento no dia em que a imobiliária tem um administrador só, que é a
   * maioria. Quem quiser que ele valide precisa dizer isso explicitamente.
   */
  validarJuridico   Boolean @default(false) @map("validar_juridico")
  validarFinanceiro Boolean @default(false) @map("validar_financeiro")
  /** Ver o split de comissão — quanto ficou com a casa e quanto com cada um. */
  verComissoes      Boolean @default(false) @map("ver_comissoes")
  /** Configurar as fontes de captação (os webhooks dos portais e das redes). */
  gerenciarCaptacao Boolean @default(false) @map("gerenciar_captacao")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuarios Usuario[]

  @@index([tenantId])
  @@map("tb_cargo")
}

// ─── Usuario ─────────────────────────────────────────────────────────────────

model Usuario {
  id                String   @id @default(cuid()) @map("usu_id")
  tenantId          String   @map("tenant_id")
  cargoCodigo       Int      @map("crg_codigo")
  nome              String   @map("usu_nome")
  login             String   @unique @map("usu_login")
  /**
   * E-mail da PESSOA, e é para onde vai a recuperação de senha.
   * Anulável porque o cadastro nunca pediu e-mail — os usuários que já existem
   * não têm nenhum, e exigir agora quebraria a tela de Usuários. Quem está sem
   * e-mail simplesmente não consegue recuperar sozinho: a tela avisa, e o
   * caminho é o administrador da imobiliária redefinir por lá.
   * Não é único: o mesmo e-mail pode ser de duas pessoas em imobiliárias
   * diferentes (o dono que administra duas). Quem identifica alguém é o
   * `login`, que continua único no sistema inteiro.
   */
  email             String?  @map("usu_email")

  /**
   * ─── Conta Google vinculada ────────────────────────────────────────────────
   *
   * `googleId` é o `sub` do token do Google: imutável e único por conta. É por
   * ELE que o login casa, nunca pelo e-mail.
   *
   * A diferença não é estilística. E-mail corporativo é reatribuível — quem
   * herda `vendas@imobiliaria.com` de um corretor que saiu entraria no sistema
   * como ele. O `sub` não é reatribuído nunca.
   *
   * `@unique` para que duas pessoas não apontem para a mesma conta Google e
   * acabem dividindo sessão.
   *
   * Nome e foto do Google ficam em campos PRÓPRIOS e não sobrescrevem o
   * cadastro: o que aparece na vitrine é decisão da imobiliária, não do perfil
   * pessoal do corretor. Servem de padrão quando o cadastro está vazio.
   */
  googleId          String?  @unique @map("usu_google_id")
  googleEmail       String?  @map("usu_google_email")
  googleFoto        String?  @map("usu_google_foto")
  googleNome        String?  @map("usu_google_nome")
  googleVinculadoEm DateTime? @map("usu_google_vinculado_em")
  senha             String   @map("usu_senha")
  forcaAlterarSenha Boolean  @default(false) @map("usu_forca_alterar_senha")
  ativo             Boolean  @default(true) @map("usu_ativo")
  /**
   * ── O que a vitrine mostra de um corretor ───────────────────────────────
   * O widget "Equipe" nasceu com três pessoas inventadas no código ("Ana
   * Souza", "João Lima") porque não havia de onde tirar as de verdade: o
   * cadastro de usuário guarda quem ENTRA no painel, não quem ATENDE o
   * cliente. Estes quatro campos são a diferença entre as duas coisas.
   * `exibirNaVitrine` é opt-in, e não o contrário. Aparecer com foto e nome
   * numa página pública é decisão da pessoa, não consequência de ter login —
   * e a imobiliária tem gente no painel que não atende ninguém (o
   * administrativo, o financeiro, o dono).
   * `creci` mora aqui e também no Tenant: o registro da EMPRESA e o registro
   * de cada CORRETOR são documentos diferentes, e o cliente que confere
   * procura o do corretor com quem falou.
   */
  /**
   * Tema do painel escolhido POR ESTA PESSOA: "escuro" | "claro" | "auto".
   * NULO é o estado que importa: significa "nunca escolhi", e aí vale o tema da
   * imobiliária. Assim o administrador que troca o tema da casa alcança quem
   * nunca opinou, e não passa por cima de quem já decidiu.
   * Sem esta distinção, ou o administrador não conseguiria definir um padrão,
   * ou trocaria o tema de quem já tinha escolhido o seu — e as duas coisas são
   * erradas de maneiras diferentes.
   */
  temaPainel      String?  @map("usu_tema_painel")

  /* Atalhos de teclado DESTA pessoa. Só o que ela mudou em relação ao padrão da
   * imobiliária — gravar a tabela inteira congelaria a escolha dela num
   * instantâneo do catálogo, e um atalho novo nunca chegaria a quem já mexeu.
   * Formato: `{ "dashboard.imoveis": "j" }`. Ver `utils/atalhos.js`. */
  atalhos         Json?    @map("usu_atalhos")
  foto            String?  @map("usu_foto")
  creci           String?  @map("usu_creci")
  whatsapp        String   @default("") @map("usu_whatsapp")
  exibirNaVitrine Boolean  @default(false) @map("usu_exibir_na_vitrine")
  cargoVitrine    String?  @map("usu_cargo_vitrine")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cargo           Cargo             @relation(fields: [cargoCodigo], references: [id])
  vendas          Venda[]
  tutorial        UsuarioTutorial[]
  chamados        Chamado[]
  /**
   * Identificador que o registro tinha no sistema de origem, quando veio de uma
   * importação. Nulo em tudo que nasceu aqui dentro.
   * Existe por um motivo prático: reimportar é a norma, não a exceção. A
   * primeira tentativa quase sempre tem uma coluna mapeada errada, e sem uma
   * chave estável a segunda tentativa duplicaria tudo em vez de corrigir. Com
   * ela, a importação vira "atualize quem já veio, crie o resto".
   * Único POR TENANT: dois sistemas diferentes podem ter um imóvel "1042", e
   * eles não têm nada a ver um com o outro.
   */
  origemExterna   String?           @map("origem_externa")
  leadsAtribuidos PropertyLead[]    @relation("LeadsDoResponsavel")

  // ─── Omnimob Flow ───
  negocios           Negocio[]          @relation("NegociosDoResponsavel")
  negociosJuridico   Negocio[]          @relation("NegociosValidadosJuridico")
  negociosFinanceiro Negocio[]          @relation("NegociosValidadosFinanceiro")
  documentosEnviados NegocioDocumento[] @relation("DocumentosEnviados")

  @@unique([tenantId, origemExterna], name: "usuario_origem")
  @@index([tenantId, ativo])
  /* Busca por e-mail na recuperação de senha (`authRoutes`, findFirst por
     email). O índice existia no banco desde a migração `usuario_email`, mas não
     estava declarado aqui — e o Prisma, que compara schema com histórico,
     propunha derrubá-lo em toda migração nova. Declarado, ele para de sumir. */
  @@index([email])
  @@map("tb_usuario")
}

/**
 * ── Chave de API da imobiliária ────────────────────────────────────────────
 * O crachá que outra plataforma usa para ler e escrever no acervo deste
 * tenant. Uma linha por chave; uma imobiliária pode ter várias (a do portal, a
 * do site antigo, a do integrador) e revogar uma sem derrubar as outras.
 *
 * GUARDAMOS O HASH, NUNCA A CHAVE. O texto integral aparece uma única vez, na
 * tela, no instante em que é gerado — depois nem nós conseguimos recuperá-lo.
 * É a mesma regra da senha do usuário, e pela mesma razão: um vazamento do
 * banco não pode virar acesso ao acervo de ninguém.
 *
 * `prefixo` existe porque o hash é ilegível e a pessoa precisa reconhecer qual
 * chave revogar. São os primeiros caracteres do texto — o bastante para
 * distinguir, insuficiente para usar.
 *
 * `escopos` é lista e não booleanos porque a pergunta cresce: hoje são imóveis,
 * clientes e usuários em leitura e escrita; amanhã entram leads. Uma coluna por
 * combinação viraria doze colunas.
 *
 * `revogadaEm` em vez de DELETE: quem investiga um acesso indevido precisa
 * saber que a chave existiu, quem a criou e quando ela parou de valer.
 */
model ChaveApi {
  id         String    @id @default(cuid()) @map("cha_id")
  tenantId   String    @map("tenant_id")
  nome       String    @map("cha_nome")
  prefixo    String    @map("cha_prefixo")
  hash       String    @unique @map("cha_hash")
  escopos    String[]  @map("cha_escopos")
  ultimoUso  DateTime? @map("cha_ultimo_uso")
  revogadaEm DateTime? @map("cha_revogada_em")
  // Nome de quem gerou, copiado. Sem FK: a chave sobrevive ao desligamento de
  // quem a criou, e a trilha não pode virar "criada por (ninguém)".
  criadaPor  String?   @map("cha_criada_por")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, revogadaEm])
  @@map("tb_chave_api")
}

/**
 * ── Fonte de importação guardada ───────────────────────────────────────────
 * O endereço do feed que a imobiliária apontou, para poder ser lido DE NOVO.
 *
 * Sem esta tabela, importar era um evento: colar a URL, conferir, importar,
 * acabou. Mas o valor de um feed é justamente continuar valendo amanhã — o
 * sistema antigo publica o acervo atualizado no mesmo endereço, e quem migrou
 * na segunda quer o imóvel novo de quinta sem repetir o ritual.
 *
 * `desativarAusentes` é a política de ausência, e é opt-in. Imóvel que sai do
 * feed do outro lado deveria sair daqui — só que "sumiu do feed" e "o feed
 * quebrou e voltou vazio" são indistinguíveis de fora. Ligado, o que some vira
 * INATIVO (nunca apagado); desligado, o acervo só cresce. A escolha é de quem
 * conhece a origem.
 *
 * `ultimoResultado` guarda o relatório da última leitura para a tela mostrar o
 * que aconteceu sem refazer o trabalho.
 */
model FonteImportacao {
  id                String    @id @default(cuid()) @map("fon_id")
  tenantId          String    @map("tenant_id")
  nome              String    @map("fon_nome")
  entidade          String    @map("fon_entidade") // imoveis | clientes | usuarios
  url               String    @map("fon_url")
  ativa             Boolean   @default(true) @map("fon_ativa")
  desativarAusentes Boolean   @default(false) @map("fon_desativar_ausentes")
  ultimaSync        DateTime? @map("fon_ultima_sync")
  ultimoResultado   Json?     @map("fon_ultimo_resultado")
  criadaPor         String?   @map("fon_criada_por")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ativa])
  @@map("tb_fonte_importacao")
}

/**
 * ── Webhook de saída ───────────────────────────────────────────────────────
 * O inverso do feed. No feed, o dado é do outro lado e nós vamos buscar; aqui o
 * EVENTO é nosso — um lead entrou na vitrine —, e o CRM do cliente só
 * descobriria perguntando de tempos em tempos. Perguntar de minuto em minuto
 * para receber "nada" na quase totalidade das vezes é o desperdício que webhook
 * existe para eliminar.
 *
 * `segredo` assina cada entrega (HMAC-SHA256 no cabeçalho). Sem assinatura,
 * qualquer um que descubra a URL do cliente pode inventar leads no CRM dele —
 * a URL não é credencial, é endereço.
 *
 * `falhasSeguidas` desarma o webhook sozinho depois de muitas falhas: endereço
 * que morreu e ninguém removeu vira uma tentativa perdida por evento, para
 * sempre. Zera na primeira entrega boa.
 */
model Webhook {
  id             String    @id @default(cuid()) @map("whk_id")
  tenantId       String    @map("tenant_id")
  url            String    @map("whk_url")
  eventos        String[]  @map("whk_eventos")
  segredo        String    @map("whk_segredo")
  ativo          Boolean   @default(true) @map("whk_ativo")
  falhasSeguidas Int       @default(0) @map("whk_falhas_seguidas")
  ultimoEnvio    DateTime? @map("whk_ultimo_envio")
  ultimaFalha    String?   @map("whk_ultima_falha")
  criadoPor      String?   @map("whk_criado_por")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ativo])
  @@map("tb_webhook")
}

// ─── Tutorial guiado ─────────────────────────────────────────────────────────

/**
 * O que cada usuário fez com o tour de primeiro acesso, uma linha por etapa.
 * FINALIZADO = percorreu até o fim · PULADO = saiu no meio (com o passo onde
 * parou) · EM_ANDAMENTO = abriu e não concluiu.
 * "Não fez" é a AUSÊNCIA de linha, não um valor. Gravar PENDENTE para todo
 * mundo exigiria semear linhas na criação do usuário e de novo a cada etapa
 * nova do tour — um backfill por release, e um usuário sem linha viraria
 * "sem dados" em vez de "não fez". Quem lê monta a matriz completa cruzando
 * com o fluxo declarado; é o que faz `GET /api/tutorial`.
 */
enum TutorialStatus {
  EM_ANDAMENTO
  FINALIZADO
  PULADO
}

/**
 * ── Chamados de suporte ────────────────────────────────────────────────────
 * Abertos pelo botão de Ajuda dentro do painel da imobiliária e lidos pelo
 * super-admin.
 * `numero` é inteiro e sequencial, e não cuid como o resto do schema, porque
 * este é o único id que uma PESSOA precisa dizer em voz alta: "o chamado 214".
 * Um cuid num telefonema não funciona.
 * O usuário é opcional e vem com o nome copiado ao lado: quem abriu pode ser
 * desligado da imobiliária depois, e o histórico do suporte não pode virar
 * "aberto por (ninguém)". Já o tenant cascateia — apagada a imobiliária, os
 * chamados dela não têm mais a quem responder.
 * ──────────────────────────────────────────────────────────────────────────
 */
model Chamado {
  numero       Int               @id @default(autoincrement()) @map("cha_numero")
  tenantId     String            @map("tenant_id")
  usuarioId    String?           @map("usu_id")
  usuarioNome  String            @default("") @map("cha_usu_nome")
  titulo       String            @map("cha_titulo")
  descricao    String            @map("cha_descricao")
  categoria    String            @default("duvida") @map("cha_categoria")
  prioridade   ChamadoPrioridade @default(MEDIA) @map("cha_prioridade")
  resolvido    Boolean           @default(false) @map("cha_resolvido")
  resolvidoEm  DateTime?         @map("cha_resolvido_em")
  // URLs no Cloudinary, na ordem em que foram enviadas. Array em vez de tabela
  // filha: print de tela não tem atributo nenhum além do endereço.
  prints       String[]          @map("cha_prints")
  // Em que tela a pessoa estava. Poupa a primeira pergunta de todo atendimento.
  rota         String            @default("") @map("cha_rota")
  criadoEm     DateTime          @default(now()) @map("created_at")
  atualizadoEm DateTime          @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([tenantId, criadoEm])
  @@index([resolvido, prioridade])
  @@map("tb_chamado")
}

enum ChamadoPrioridade {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

model UsuarioTutorial {
  id           String         @id @default(cuid()) @map("tut_id")
  tenantId     String         @map("tenant_id")
  usuarioId    String         @map("usu_id")
  // Chave da etapa no fluxo declarado em apps/web/src/utils/tourFluxo.js
  // ("boas-vindas", "inicio", "imoveis"…). Texto livre de propósito: uma etapa
  // nova não pode exigir migração de enum.
  etapa        String         @map("tut_etapa")
  status       TutorialStatus @default(EM_ANDAMENTO) @map("tut_status")
  // Em que passo a pessoa estava ao pular — é o que diz ONDE ela desistiu.
  passoParou   Int?           @map("tut_passo_parou")
  totalPassos  Int?           @map("tut_total_passos")
  criadoEm     DateTime       @default(now()) @map("created_at")
  atualizadoEm DateTime       @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, etapa])
  @@index([tenantId, usuarioId])
  @@map("tb_usuario_tutorial")
}

// ─── Cliente ─────────────────────────────────────────────────────────────────

model Cliente {
  id                String    @id @default(cuid()) @map("clt_id")
  tenantId          String    @map("tenant_id")
  nome              String    @map("clt_nome")
  cpf               String?   @map("clt_cpf")
  rg                String?   @map("clt_rg")
  nascimento        DateTime? @map("clt_nascimento") @db.Date
  email             String?   @map("clt_email")
  telefone          String?   @map("clt_telefone")
  whatsapp          String?   @map("clt_whatsapp")
  cep               String?   @map("clt_cep")
  endereco          String?   @map("clt_endereco")
  bairro            String?   @map("clt_bairro")
  cidade            String?   @map("clt_cidade")
  estado            String?   @map("clt_estado")
  numero            String?   @map("clt_numero")
  /**
   * ─── A QUALIFICAÇÃO ────────────────────────────────────────────────────────
   * Nacionalidade, estado civil e profissão não são enfeite de cadastro: são o
   * que a lei chama de qualificação das partes, e nenhuma minuta de compra e
   * venda existe sem as três. Enquanto elas não existiam, o motor de contratos
   * (services/flow/minutas.js) tinha três marcadores permanentemente em
   * pendência e a imobiliária completava à mão — que é exatamente o trabalho
   * que o módulo promete eliminar.
   * Opcionais porque o Hub não precisa delas: quem só anuncia imóvel cadastra
   * cliente com nome e telefone, e exigir profissão ali seria cobrar do módulo
   * errado.
   */
  nacionalidade     String?   @map("clt_nacionalidade")
  estadoCivil       String?   @map("clt_estado_civil")
  profissao         String?   @map("clt_profissao")
  observacoes       String?   @map("clt_observacoes") @db.Text
  ativo             Boolean   @default(true) @map("clt_ativo")
  // Contato optou por receber divulgações de imóveis (base para broadcast WhatsApp).
  aceitaDivulgacao  Boolean   @default(false) @map("clt_aceita_divulgacao")
  divulgacaoOptInAt DateTime? @map("clt_divulgacao_optin_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendas        Venda[]
  /**
   * Identificador que o registro tinha no sistema de origem, quando veio de uma
   * importação. Nulo em tudo que nasceu aqui dentro.
   * Existe por um motivo prático: reimportar é a norma, não a exceção. A
   * primeira tentativa quase sempre tem uma coluna mapeada errada, e sem uma
   * chave estável a segunda tentativa duplicaria tudo em vez de corrigir. Com
   * ela, a importação vira "atualize quem já veio, crie o resto".
   * Único POR TENANT: dois sistemas diferentes podem ter um imóvel "1042", e
   * eles não têm nada a ver um com o outro.
   */
  origemExterna String?       @map("origem_externa")
  perfisBusca   PerfilBusca[]

  // ─── Omnimob Flow ───
  negociosComprando Negocio[] @relation("NegociosComoComprador")
  negociosVendendo  Negocio[] @relation("NegociosComoVendedor")

  @@unique([tenantId, origemExterna], name: "cliente_origem")
  @@index([tenantId, ativo])
  @@index([tenantId, cpf])
  @@index([tenantId, aceitaDivulgacao])
  @@map("tb_cliente")
}

// ─── Venda ───────────────────────────────────────────────────────────────────

model Venda {
  id          String    @id @default(cuid()) @map("ven_id")
  tenantId    String    @map("tenant_id")
  propertyId  String    @map("property_id")
  clienteId   String    @map("clt_id")
  usuarioId   String    @map("usu_id")
  tipo        TipoVenda @map("ven_tipo")
  valor       Decimal   @map("ven_valor") @db.Decimal(12, 2)
  data        DateTime  @map("ven_data") @db.Date
  comissao    Decimal?  @map("ven_comissao") @db.Decimal(12, 2)
  observacoes String?   @map("ven_observacoes") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  cliente  Cliente  @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([tenantId, data])
  @@index([tenantId, propertyId])
  @@index([tenantId, clienteId])
  @@map("tb_venda")
}

// ─── Tipos de Imóvel e Atributos ─────────────────────────────────────────────

/**
 * Tipo de imóvel é de UMA imobiliária.
 * Mesma história do `Cargo`: nasceu sem `tenantId` e a tabela era global — só
 * que aqui havia CRUD aberto na tela de Tipos de Imóvel. Uma imobiliária
 * renomear "Apartamento" renomeava para todas; excluir excluía de todas. Os
 * atributos (`ModeloAtributo`) vão junto por herança: eles pertencem ao tipo, e
 * o tipo agora tem dono.
 */
model TipoImovel {
  id         Int    @id @default(autoincrement()) @map("tip_id")
  tenantId   String @map("tenant_id")
  descricao  String @map("tip_descricao")
  areaFields Json   @default("[]") @map("tip_area_fields")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  atributos ModeloAtributo[]
  imoveis   Property[]

  perfisBusca PerfilBusca[]

  @@index([tenantId])
  @@map("tb_tipo_imovel")
}

model ModeloAtributo {
  id        Int     @id @default(autoincrement()) @map("atr_id")
  tipoId    Int     @map("tip_id")
  descricao String  @map("atr_descricao")
  grupo     String? @map("atr_grupo")

  tipo    TipoImovel       @relation(fields: [tipoId], references: [id], onDelete: Cascade)
  imoveis ImovelAtributo[]

  @@map("tb_modelo_atributo")
}

model ImovelAtributo {
  propertyId String @map("property_id")
  atributoId Int    @map("atr_id")

  property Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  atributo ModeloAtributo @relation(fields: [atributoId], references: [id], onDelete: Cascade)

  @@id([propertyId, atributoId])
  @@map("tb_imovel_atributo")
}

// ─── Imóveis ─────────────────────────────────────────────────────────────────

model Property {
  id              String           @id @default(cuid())
  tenantId        String
  tipoImovelId    Int?             @map("tip_id")
  propertyType    String           @default("") // mantido para compatibilidade, derivado de tipoImovel.descricao
  title           String
  description     String
  price           Decimal          @db.Decimal(12, 2)
  cep             String?
  address         String
  neighborhood    String           @default("")
  city            String           @default("")
  state           String           @default("")
  bedrooms        Int              @default(0)
  parkingSpots    Int              @default(0)
  suites          Int              @default(0)
  salas           Int              @default(0) // nº de salas/ambientes (imóveis comerciais)
  banheiros       Int              @default(0) // nº de banheiros (imóveis comerciais)
  squareFootage   Float            @default(0)
  finalidade      String? // RESIDENCIAL | COMERCIAL
  areaTerreno     Float?           @map("area_terreno")
  areaConstruida  Float?           @map("area_construida")
  areaPrivativa   Float?           @map("area_privativa")
  areaTotal       Float?           @map("area_total")
  andamento       AndamentoImovel?
  tipoContrato    TipoContrato?    @map("tipo_contrato") // nulo nos imóveis cadastrados antes do campo existir
  aceitaPermuta   Boolean          @default(false) @map("aceita_permuta")
  comodidades     Json? // comodidades da regiao detectadas pelo CEP (ex.: { possuiMercado: true })
  status          PropertyStatus   @default(DRAFT)
  /**
   * Entra no XML que os portais (ZAP, VivaReal, Imovelweb) buscam.
   * Padrão ligado, e separado de `status`: um imóvel pode estar ativo na
   * vitrine da imobiliária e fora dos portais de propósito — exclusividade em
   * negociação, imóvel de carteira, ou simplesmente porque o portal cobra por
   * anúncio. Sem este campo, "publicar tudo" seria a única política possível.
   */
  publicarPortais Boolean          @default(true) @map("prp_publicar_portais")

  /* QUAIS portais, agora que eles deixaram de ser um interruptor só.
   *
   * `publicarPortais` continua sendo o mestre — vai para portal, sim ou não —
   * e este campo diz para quais. Vazio com o mestre ligado significa TODOS, e
   * não nenhum: é o estado de todo imóvel cadastrado antes desta separação, e
   * lê-lo como "nenhum" tiraria o acervo inteiro do ar em silêncio.
   *
   * Ver `services/portais.js`. */
  portais         String[]         @map("prp_portais")
  /**
   * Mostrar a RUA E O NÚMERO na página pública do imóvel.
   * Desligado por padrão, e o padrão é a parte que importa: bairro e cidade
   * bastam para o visitante se situar, e o endereço exato é o que transforma
   * um anúncio em convite para bater na porta de quem ainda mora lá. Também é
   * o que permite alguém fechar negócio direto com o proprietário, passando por
   * fora da imobiliária que anunciou.
   * Quando desligado, o endereço NÃO é omitido só na tela: ele sai do payload
   * público inteiro (ver `publicRoutes`) e o feed dos portais passa a pedir
   * exibição por bairro. Esconder na interface e mandar no JSON seria esconder
   * de quem olha e entregar a quem procura.
   */
  /**
   * Número da matrícula no Cartório de Registro de Imóveis.
   * É O identificador legal do imóvel — o que a escritura, a certidão e o
   * contrato citam. O sistema tinha endereço e não tinha isto, e o resultado é
   * que toda minuta gerada saía com a matrícula em branco para ser preenchida à
   * mão, no documento que menos admite preenchimento à mão.
   * Texto e não número: matrícula tem formato de cartório, com pontos, traços e
   * às vezes letra.
   */
  matricula              String?               @map("prp_matricula")
  exibirEnderecoCompleto Boolean     @default(false) @map("prp_exibir_endereco_completo")
  viewCount       Int              @default(0)
  leadCount       Int              @default(0)
  saleCount       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipoImovel    TipoImovel?           @relation(fields: [tipoImovelId], references: [id])
  atributos     ImovelAtributo[]
  publications  PropertyPublication[]
  images        PropertyImage[]
  metricEvents  PropertyMetricEvent[]
  leads         PropertyLead[]
  vendas        Venda[]
  /**
   * Identificador que o registro tinha no sistema de origem, quando veio de uma
   * importação. Nulo em tudo que nasceu aqui dentro.
   * Existe por um motivo prático: reimportar é a norma, não a exceção. A
   * primeira tentativa quase sempre tem uma coluna mapeada errada, e sem uma
   * chave estável a segunda tentativa duplicaria tudo em vez de corrigir. Com
   * ela, a importação vira "atualize quem já veio, crie o resto".
   * Único POR TENANT: dois sistemas diferentes podem ter um imóvel "1042", e
   * eles não têm nada a ver um com o outro.
   */
  origemExterna String?               @map("origem_externa")

  // ─── Omnimob Flow ───
  negocios Negocio[]

  @@unique([tenantId, origemExterna], name: "property_origem")
  @@index([tenantId, status])
}

model PropertyPublication {
  id            String             @id @default(cuid())
  tenantId      String
  propertyId    String
  channel       PublicationChannel
  status        PublicationStatus  @default(PENDING)
  externalRef   String?
  caption       String?
  errorMessage  String?
  lastAttemptAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Um imóvel pode ter VÁRIOS posts na mesma rede (ex.: manter o anúncio
  // original e publicar um novo após uma edição). Cada post é uma linha, com
  // seu próprio externalRef, removível individualmente.
  @@index([propertyId, channel])
  @@index([tenantId, status])
}

model PropertyMetricEvent {
  id         String          @id @default(cuid())
  tenantId   String
  propertyId String
  type       MetricEventType
  createdAt  DateTime        @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId, propertyId, type, createdAt])
}

model PropertyImage {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  url        String
  publicId   String?
  position   Int      @default(0)
  is360      Boolean  @default(false)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId, propertyId, position])
}

/**
 * Lead: quem levantou a mão na vitrine.
 * Nasceu como caixa de entrada — nome, telefone, mensagem — e era só isso. Sem
 * DONO e sem ESTÁGIO não existe atendimento, existe uma lista: ninguém sabe de
 * quem é o lead, ninguém sabe se alguém já ligou, e o "funil de vendas" tinha
 * de ser inferido de eventos de visualização, que medem o site e não a equipe.
 * Os três campos abaixo mudam isso, e o histórico (`LeadEvento`) responde a
 * pergunta que aparece toda semana numa imobiliária: "o que foi feito com este
 * contato?".
 */
model PropertyLead {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  name       String?
  email      String?
  phone      String?
  message    String?
  source     String   @default("showcase")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  estagio           LeadEstagio @default(NOVO)
  /**
   * Corretor responsável. Opcional porque a distribuição automática pode não
   * ter ninguém elegível — imobiliária de uma pessoa só, ou equipe inteira sem
   * a permissão de atender. Nesse caso o lead cai na caixa comum, que é melhor
   * do que atribuí-lo a alguém que não deveria vê-lo.
   */
  responsavelId     String?
  /**
   * Quando alguém encostou no lead pela primeira vez. É o que permite medir
   * tempo de primeira resposta — o número que mais separa imobiliária que
   * converte de imobiliária que não converte.
   */
  primeiroContatoEm DateTime?

  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /**
   * SetNull e não Cascade: desligar um corretor não pode apagar os leads que
   * ele atendeu. Eles voltam para a caixa comum e alguém assume.
   */
  responsavel Usuario?     @relation("LeadsDoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  eventos     LeadEvento[]
  // ─── Omnimob Flow ───
  negocios    Negocio[]

  @@index([tenantId, propertyId, createdAt])
  @@index([tenantId, estagio])
  @@index([tenantId, responsavelId])
}

/**
 * Uma linha por coisa que aconteceu com o lead.
 * `usuarioNome` é gravado junto e de propósito, apesar de `usuarioId` existir:
 * o histórico precisa continuar legível depois que a pessoa sai da empresa e o
 * usuário é removido. Um histórico que vira "(usuário excluído) mudou o estágio"
 * perde exatamente a informação pela qual ele existe.
 */
model LeadEvento {
  id          String         @id @default(cuid()) @map("lev_id")
  tenantId    String         @map("tenant_id")
  leadId      String         @map("lea_id")
  usuarioId   String?        @map("usu_id")
  usuarioNome String?        @map("lev_usuario_nome")
  tipo        LeadEventoTipo @map("lev_tipo")
  de          String?        @map("lev_de")
  para        String?        @map("lev_para")
  texto       String?        @map("lev_texto") @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   PropertyLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, createdAt])
  @@map("tb_lead_evento")
}

// ─── Auditoria ───────────────────────────────────────────────────────────────

/**
 * Quem fez o quê, quando.
 * Escrita por uma extensão do Prisma Client (`services/auditoria.js`), não por
 * chamada espalhada nas rotas — é o que faz a trilha valer inclusive para as
 * rotas que ainda não existem. Quem escreve uma rota nova não precisa lembrar
 * de nada.
 * NÃO tem relação com `Usuario`, e é deliberado: o registro precisa sobreviver
 * à remoção de quem o gerou. Por isso `usuarioId` é texto solto e o nome vem
 * gravado junto — um log que diz "(excluído) apagou o imóvel" não responde a
 * pergunta pela qual ele foi criado. Com o tenant é o contrário: se a
 * imobiliária sai, o histórico dela sai junto.
 */
model Auditoria {
  id          String   @id @default(cuid()) @map("aud_id")
  tenantId    String   @map("tenant_id")
  usuarioId   String?  @map("usu_id")
  usuarioNome String?  @map("aud_usuario_nome")
  /**
   * CRIOU | ALTEROU | EXCLUIU. Em português porque aparece cru na tela — e
   * traduzir na interface seria um segundo lugar para desencontrar do primeiro.
   */
  acao        String   @map("aud_acao")
  entidade    String   @map("aud_entidade")
  entidadeId  String?  @map("aud_entidade_id")
  /**
   * Como a pessoa reconhece o registro: o título do imóvel, o nome do cliente.
   * Sem ele o log diria "excluiu Property cmc3x9…", que não é resposta.
   */
  resumo      String?  @map("aud_resumo")
  /**
   * Os campos que mudaram, já sem senha nem token (ver `limparSegredos`).
   */
  dados       Json?    @map("aud_dados")
  ip          String?  @map("aud_ip")
  rota        String?  @map("aud_rota")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entidade, entidadeId])
  @@index([tenantId, usuarioId, createdAt])
  @@map("tb_auditoria")
}

// ─── Perfil de busca ─────────────────────────────────────────────────────────

/**
 * O que um cliente procura.
 * A imobiliária já tem a base de clientes e já tem o acervo; o que faltava era
 * a ligação entre os dois. Com o perfil gravado, cadastrar um imóvel passa a
 * responder sozinho "quem da minha carteira estava esperando por isto" — que é
 * o cruzamento que os sistemas grandes vendem como inteligência e que aqui é
 * uma consulta com índice.
 * Todos os critérios são opcionais de propósito: perfil pela metade ainda
 * cruza. Exigir o formulário completo faria a maioria não ser preenchida, e um
 * perfil vazio é o único que não serve para nada.
 */
model PerfilBusca {
  id            String        @id @default(cuid()) @map("pfb_id")
  tenantId      String        @map("tenant_id")
  clienteId     String        @map("clt_id")
  titulo        String        @map("pfb_titulo")
  finalidade    String?       @map("pfb_finalidade") // RESIDENCIAL | COMERCIAL
  tipoContrato  TipoContrato? @map("pfb_tipo_contrato")
  tipoImovelId  Int?          @map("tip_id")
  precoMin      Decimal?      @map("pfb_preco_min") @db.Decimal(12, 2)
  precoMax      Decimal?      @map("pfb_preco_max") @db.Decimal(12, 2)
  quartosMin    Int?          @map("pfb_quartos_min")
  vagasMin      Int?          @map("pfb_vagas_min")
  areaMin       Float?        @map("pfb_area_min")
  cidade        String?       @map("pfb_cidade")
  /**
   * Lista de bairros aceitos. Vazia significa "qualquer bairro da cidade" —
   * e não "nenhum", que tornaria o perfil impossível de casar.
   */
  bairros       String[]      @map("pfb_bairros")
  ativo         Boolean       @default(true) @map("pfb_ativo")
  /**
   * Trava do aviso automático: quando o cruzamento avisou este perfil pela
   * última vez. Sem ela, uma edição em massa no acervo dispararia dezenas de
   * e-mails para o mesmo cliente no mesmo minuto.
   */
  ultimoAvisoEm DateTime?     @map("pfb_ultimo_aviso_em")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente    Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipoImovel TipoImovel? @relation(fields: [tipoImovelId], references: [id])

  @@index([tenantId, ativo])
  @@index([tenantId, clienteId])
  @@map("tb_perfil_busca")
}

// ═══════════════════════════════════════════════════════════════════════════
// OMNIMOB FLOW — captação, funil, contrato e comissão
// ═══════════════════════════════════════════════════════════════════════════
//
// O Hub responde "o que a imobiliária TEM" (acervo, vitrine, equipe). O Flow
// responde "o que a imobiliária está FECHANDO". São dois assuntos, e por isso
// dois módulos: quem só anuncia não precisa de minuta contratual, e quem só
// fecha não precisa de editor de vitrine.
//
// ── A LIGAÇÃO ENTRE OS DOIS ──
//
// Um Negocio aponta para o PropertyLead que o originou, e o lead continua
// sendo do Hub. NÃO existe uma segunda tabela de leads: o webhook de captação
// grava no PropertyLead de sempre e abre um negócio ao lado. Duas caixas de
// entrada divergiriam no primeiro mês, e a imobiliária passaria a ter dois
// números diferentes para "quantos interessados chegaram ontem".
//
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Os módulos do produto. Ver Tenant.modulos e Cargo.acessarFlow.
 * Enum e não texto livre: ao contrário de UsuarioTutorial.etapa, aqui a lista
 * é fechada por natureza — módulo novo é uma decisão de produto com tela, preço
 * e migração, não uma string que aparece sozinha.
 */
enum ModuloOmnimob {
  HUB
  FLOW
}

/**
 * ─── O funil do Flow ───────────────────────────────────────────────────────
 *
 * Sete estágios de avanço mais um de saída. Não é o mesmo funil de
 * LeadEstagio, e a diferença é de OBJETO: aquele descreve um interessado que
 * mandou mensagem; este descreve um negócio de setecentos mil reais em
 * aprovação jurídica. Misturar os dois faria a caixa de entrada do corretor
 * mostrar contratos e o relatório de conversão contar curiosos como propostas.
 *
 * PERDIDO fica fora da sequência de propósito: ele é alcançável de qualquer
 * estágio e não tem "próximo". Um funil que o desenha entre APROVACAO e GANHO
 * sugere que se passa por ele.
 */
enum NegocioEstagio {
  LEAD
  CONTATO
  VISITA
  PROPOSTA
  NEGOCIACAO
  APROVACAO
  GANHO
  PERDIDO
}

enum NegocioEventoTipo {
  CRIADO
  ESTAGIO
  RESPONSAVEL
  NOTA
  DOCUMENTO
  CONTRATO
  VALIDACAO
  COMISSAO
}

/**
 * De onde o interessado veio. É o que responde "qual portal vale o que
 * pagamos?" — pergunta que a imobiliária faz todo mês e que hoje ela responde
 * de memória.
 */
enum CanalCaptacao {
  ZAP
  VIVAREAL
  OLX
  MERCADOLIVRE
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  SITE
  INDICACAO
  OUTRO
}

enum ContratoStatus {
  RASCUNHO
  ENVIADO
  PARCIAL
  ASSINADO
  RECUSADO
  CANCELADO
  EXPIRADO
}

enum SignatarioStatus {
  PENDENTE
  ASSINADO
  RECUSADO
}

/**
 * O papel de quem assina. Guardado no signatário e não deduzido da ordem: um
 * contrato com dois compradores e um procurador não tem ordem que descreva quem
 * é quem, e "o segundo é sempre o vendedor" quebra no primeiro caso real.
 */
enum SignatarioPapel {
  COMPRADOR
  VENDEDOR
  IMOBILIARIA
  TESTEMUNHA
  FIADOR
  PROCURADOR
}

enum DocumentoTipo {
  RG
  CPF
  CNPJ
  COMPROVANTE_RENDA
  COMPROVANTE_RESIDENCIA
  CERTIDAO_ESTADO_CIVIL
  MATRICULA_IMOVEL
  IPTU
  CONTRATO_SOCIAL
  PROCURACAO
  OUTRO
}

// ─── Negócio ─────────────────────────────────────────────────────────────────

/**
 * Um negócio em andamento: alguém querendo um imóvel, alguém vendendo, e o
 * caminho entre as duas coisas.
 *
 * ── POR QUE O CÓDIGO É INTEIRO E SEQUENCIAL ──
 *
 * Mesma razão do Chamado.numero: este é um id que PESSOAS dizem em voz alta.
 * "O negócio 412 travou no jurídico" funciona ao telefone; um cuid não. O
 * sequencial é global e não por tenant — numeração por imobiliária exigiria uma
 * sequence por tenant ou um contador com trava, e o ganho seria cosmético.
 *
 * ── AS DUAS PONTAS DA NEGOCIAÇÃO ──
 *
 * comprador e vendedor são dois Cliente. O vendedor costuma ser o proprietário
 * do imóvel e é opcional porque o negócio nasce antes de a imobiliária saber
 * quem ele é — quando o lead chega, existe interessado e imóvel, e mais nada.
 * Exigi-los na criação faria o webhook falhar em todo lead capturado, que é
 * justamente o caso de uso principal.
 *
 * ── O QUE ESTA TABELA NÃO DECIDE ──
 *
 * Se o negócio PODE ir para GANHO. Isso depende das duas validações e do
 * contrato assinado, e a regra mora em services/flow/funil.js, num lugar só —
 * a mesma trava vale para a tela, para a API pública e para qualquer rota nova.
 */
model Negocio {
  id       String @id @default(cuid()) @map("neg_id")
  codigo   Int    @unique @default(autoincrement()) @map("neg_codigo")
  tenantId String @map("tenant_id")

  titulo  String         @map("neg_titulo")
  estagio NegocioEstagio @default(LEAD) @map("neg_estagio")

  propertyId  String? @map("property_id")
  leadId      String? @map("lea_id")
  compradorId String? @map("neg_comprador_id")
  vendedorId  String? @map("neg_vendedor_id")
  /**
   * O corretor dono do negócio. Sai da MESMA roleta que distribui os leads
   * (services/distribuicaoLeads.js) — duas filas produziriam dois rodízios
   * desencontrados, e o corretor que recebeu o lead descobriria o negócio dele
   * na mão de outra pessoa.
   */
  responsavelId String? @map("neg_responsavel_id")

  canal CanalCaptacao @default(SITE) @map("neg_canal")
  /** Texto livre com a origem exata ("zap-imoveis", "campanha-facebook-out"). */
  origem String @default("") @map("neg_origem")

  valorProposta Decimal? @map("neg_valor_proposta") @db.Decimal(12, 2)
  valorFechado  Decimal? @map("neg_valor_fechado") @db.Decimal(12, 2)

  /**
   * ── AS DUAS TRAVAS ──
   * Marcadas por gente, uma a uma, por quem tem a permissão do setor. Guardamos
   * QUEM e QUANDO junto do booleano: "o financeiro liberou" sem nome nem data
   * não serve para nada no dia em que a operação é questionada, que é
   * exatamente o dia em que alguém vem ler esta linha.
   */
  juridicoOk    Boolean   @default(false) @map("neg_juridico_ok")
  juridicoPorId String?   @map("neg_juridico_por")
  juridicoEm    DateTime? @map("neg_juridico_em")
  juridicoNota  String?   @map("neg_juridico_nota") @db.Text

  financeiroOk    Boolean   @default(false) @map("neg_financeiro_ok")
  financeiroPorId String?   @map("neg_financeiro_por")
  financeiroEm    DateTime? @map("neg_financeiro_em")
  financeiroNota  String?   @map("neg_financeiro_nota") @db.Text

  /**
   * ── O split, CONGELADO ──
   * Os percentuais são copiados do tenant no momento do cálculo, e os valores
   * gravados em vez de recalculados na leitura. A imobiliária muda a política
   * de comissão e o negócio fechado em março não pode mudar junto — quem
   * recebeu já recebeu, e um relatório que reescreve o passado é pior que
   * relatório nenhum.
   */
  comissaoPercentual   Decimal?  @map("neg_comissao_percentual") @db.Decimal(5, 2)
  comissaoCorretorPerc Decimal?  @map("neg_comissao_corretor_perc") @db.Decimal(5, 2)
  comissaoTotal        Decimal?  @map("neg_comissao_total") @db.Decimal(12, 2)
  comissaoImobiliaria  Decimal?  @map("neg_comissao_imobiliaria") @db.Decimal(12, 2)
  comissaoCorretor     Decimal?  @map("neg_comissao_corretor") @db.Decimal(12, 2)
  comissaoCalculadaEm  DateTime? @map("neg_comissao_calculada_em")

  perdidoMotivo String?   @map("neg_perdido_motivo")
  fechadoEm     DateTime? @map("neg_fechado_em")
  /** Última vez que alguém encostou no negócio — alimenta o alerta de parado. */
  ultimoContatoEm DateTime? @map("neg_ultimo_contato_em")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property  Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  lead      PropertyLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  comprador Cliente?      @relation("NegociosComoComprador", fields: [compradorId], references: [id], onDelete: SetNull)
  vendedor  Cliente?      @relation("NegociosComoVendedor", fields: [vendedorId], references: [id], onDelete: SetNull)
  /** SetNull como nos leads: desligar um corretor não apaga os negócios dele. */
  responsavel   Usuario? @relation("NegociosDoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  juridicoPor   Usuario? @relation("NegociosValidadosJuridico", fields: [juridicoPorId], references: [id], onDelete: SetNull)
  financeiroPor Usuario? @relation("NegociosValidadosFinanceiro", fields: [financeiroPorId], references: [id], onDelete: SetNull)

  eventos    NegocioEvento[]
  documentos NegocioDocumento[]
  contratos  Contrato[]

  @@index([tenantId, estagio])
  @@index([tenantId, responsavelId])
  @@index([tenantId, createdAt])
  @@index([tenantId, propertyId])
  @@map("tb_negocio")
}

/**
 * O histórico do negócio, uma linha por coisa que aconteceu.
 * Mesma forma de LeadEvento, inclusive o usuarioNome copiado: o histórico de um
 * negócio precisa continuar legível depois que o corretor sai da empresa.
 */
model NegocioEvento {
  id          String            @id @default(cuid()) @map("nev_id")
  tenantId    String            @map("tenant_id")
  negocioId   String            @map("neg_id")
  usuarioId   String?           @map("usu_id")
  usuarioNome String?           @map("nev_usuario_nome")
  tipo        NegocioEventoTipo @map("nev_tipo")
  de          String?           @map("nev_de")
  para        String?           @map("nev_para")
  texto       String?           @map("nev_texto") @db.Text
  createdAt   DateTime          @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  negocio Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@index([tenantId, negocioId, createdAt])
  @@map("tb_negocio_evento")
}

/**
 * Documento de comprovação cadastral anexado ao negócio.
 *
 * O arquivo vai direto do navegador para o Cloudinary, como a foto do imóvel —
 * o backend nunca vê o binário. O que fica aqui é o endereço e o que ele é.
 *
 * verificado é separado de "existe o arquivo" de propósito: subir um PDF não é
 * o mesmo que alguém ter conferido que ele bate com o CPF do comprador. A trava
 * de fechamento olha a validação do SETOR (no negócio), não esta marca — ela
 * serve para o conferente saber o que já passou pelo olho dele.
 */
model NegocioDocumento {
  id        String        @id @default(cuid()) @map("ndo_id")
  tenantId  String        @map("tenant_id")
  negocioId String        @map("neg_id")
  tipo      DocumentoTipo @default(OUTRO) @map("ndo_tipo")
  /** De quem é o documento: "comprador", "vendedor" ou "imovel". */
  refereA String @default("comprador") @map("ndo_refere_a")
  nome    String @map("ndo_nome")
  url     String @map("ndo_url")
  mime    String @default("") @map("ndo_mime")
  tamanho Int?   @map("ndo_tamanho")

  verificado   Boolean   @default(false) @map("ndo_verificado")
  verificadoEm DateTime? @map("ndo_verificado_em")
  observacao   String?   @map("ndo_observacao") @db.Text

  enviadoPorId String?  @map("ndo_enviado_por")
  createdAt    DateTime @default(now()) @map("created_at")

  negocio    Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  enviadoPor Usuario? @relation("DocumentosEnviados", fields: [enviadoPorId], references: [id], onDelete: SetNull)

  @@index([tenantId, negocioId])
  @@map("tb_negocio_documento")
}

// ─── Minutas e contratos ─────────────────────────────────────────────────────

/**
 * A minuta em branco: o texto do contrato com marcadores no lugar dos dados.
 *
 * Os marcadores (comprador.nome, imovel.endereco, negocio.valorFechado) estão
 * catalogados em services/flow/minutas.js, e é de lá que a tela tira a lista
 * que mostra ao lado do editor. Marcador desconhecido NÃO é apagado em
 * silêncio: o motor devolve a lista de pendências e a tela recusa gerar. Um
 * contrato que sai com um marcador impresso no meio do parágrafo é pior que um
 * contrato que não sai.
 *
 * Uma imobiliária tem várias: compra e venda, locação residencial, locação
 * comercial, autorização de venda. tipo só existe para agrupá-las na tela.
 */
model ModeloContrato {
  id       String  @id @default(cuid()) @map("mct_id")
  tenantId String  @map("tenant_id")
  nome     String  @map("mct_nome")
  tipo     String  @default("VENDA") @map("mct_tipo")
  corpo    String  @map("mct_corpo") @db.Text
  ativo    Boolean @default(true) @map("mct_ativo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contratos Contrato[]

  @@index([tenantId, ativo])
  @@map("tb_modelo_contrato")
}

/**
 * A minuta PREENCHIDA, já com os dados daquele negócio, e o rastro dela no
 * provedor de assinatura.
 *
 * ── O CORPO É CONGELADO, e isso é o ponto ──
 *
 * corpo guarda o texto renderizado no momento da geração, e não uma referência
 * ao modelo. A imobiliária edita a minuta padrão em julho e o contrato assinado
 * em maio não pode mudar junto — o que foi assinado foi aquele texto. modeloId
 * fica só para dizer de onde ele saiu, e é SetNull: apagar o modelo não pode
 * levar embora contratos assinados.
 *
 * ── STATUS EM TEMPO REAL ──
 *
 * status é atualizado por duas vias: o webhook do provedor
 * (POST /api/flow/assinatura/webhook/:provedor) e uma releitura sob demanda
 * quando a tela abre. As duas porque webhook se perde — e "o cliente jura que
 * assinou e o painel diz pendente" é o tipo de dúvida que não se resolve
 * esperando.
 */
model Contrato {
  id        String         @id @default(cuid()) @map("ctr_id")
  tenantId  String         @map("tenant_id")
  negocioId String         @map("neg_id")
  modeloId  String?        @map("mct_id")
  titulo    String         @map("ctr_titulo")
  corpo     String         @map("ctr_corpo") @db.Text
  status    ContratoStatus @default(RASCUNHO) @map("ctr_status")

  /**
   * "clicksign" ou "docusign". Copiado no envio: trocar de fornecedor não pode
   * deixar contratos antigos apontando para a API errada.
   */
  provedor         String? @map("ctr_provedor")
  documentoExterno String? @map("ctr_documento_externo")
  urlDocumento     String? @map("ctr_url_documento")
  /**
   * O PDF assinado, baixado do provedor e guardado por nós. Sem isto, cancelar
   * a conta na Clicksign levaria junto a prova de todos os contratos.
   */
  urlAssinado String? @map("ctr_url_assinado")

  enviadoEm   DateTime? @map("ctr_enviado_em")
  assinadoEm  DateTime? @map("ctr_assinado_em")
  canceladoEm DateTime? @map("ctr_cancelado_em")
  /** Última vez que perguntamos ao provedor como está. */
  sincronizadoEm DateTime? @map("ctr_sincronizado_em")
  ultimoErro     String?   @map("ctr_ultimo_erro") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  negocio     Negocio              @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  modelo      ModeloContrato?      @relation(fields: [modeloId], references: [id], onDelete: SetNull)
  signatarios ContratoSignatario[]

  @@index([tenantId, negocioId])
  @@index([tenantId, status])
  @@map("tb_contrato")
}

/**
 * Quem tem que assinar, e se já assinou.
 * Sem FK para Cliente ou Usuario: o signatário é um nome, um e-mail e um papel
 * no momento do envio. Testemunha e procurador muitas vezes não são cadastro
 * nenhum no sistema, e exigir que fossem transformaria "mandar para assinar" em
 * "cadastre mais duas pessoas primeiro".
 */
model ContratoSignatario {
  id         String           @id @default(cuid()) @map("csg_id")
  contratoId String           @map("ctr_id")
  nome       String           @map("csg_nome")
  email      String           @map("csg_email")
  documento  String?          @map("csg_documento")
  papel      SignatarioPapel  @default(COMPRADOR) @map("csg_papel")
  ordem      Int              @default(0) @map("csg_ordem")
  status     SignatarioStatus @default(PENDENTE) @map("csg_status")
  assinadoEm DateTime?        @map("csg_assinado_em")
  /**
   * O id que o provedor deu para este signatário — é por ele que o webhook
   * encontra quem assinou.
   */
  chaveExterna  String? @map("csg_chave_externa")
  urlAssinatura String? @map("csg_url_assinatura")

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@index([contratoId])
  @@map("tb_contrato_signatario")
}

// ─── Captação ────────────────────────────────────────────────────────────────

/**
 * Uma porta de entrada de lead: o webhook que um portal ou uma rede social
 * chama quando alguém demonstra interesse.
 *
 * ── POR QUE UMA LINHA POR FONTE, E NÃO UM ENDEREÇO SÓ ──
 *
 * Porque o segredo é por fonte. Com um webhook único, vazar a URL do ZAP daria
 * a quem a tivesse o poder de injetar lead falso dizendo que veio do Facebook.
 * Com uma fonte por canal, revogar o ZAP não derruba o resto — é a mesma razão
 * de ChaveApi existir por integração e não por tenant.
 *
 * segredo é guardado em claro, ao contrário da ChaveApi: aqui ele não autentica
 * sozinho, ele ASSINA (HMAC do corpo, como em services/webhooks.js, só que na
 * direção contrária). Hash não serve para conferir assinatura — para recalcular
 * o HMAC é preciso o segredo, não o resumo dele.
 */
model FonteCaptacao {
  id       String        @id @default(cuid()) @map("fca_id")
  tenantId String        @map("tenant_id")
  nome     String        @map("fca_nome")
  canal    CanalCaptacao @map("fca_canal")
  /** A parte pública do endereço: /api/captacao/:chave */
  chave   String  @unique @map("fca_chave")
  segredo String  @map("fca_segredo")
  ativa   Boolean @default(true) @map("fca_ativa")

  /**
   * O que fazer com o lead que chega: abrir negócio no funil (o padrão) ou só
   * registrar o lead. Nem toda fonte merece um negócio — uma campanha de
   * captação de PROPRIETÁRIO enche o funil de vendas de gente que quer anunciar.
   */
  abrirNegocio Boolean @default(true) @map("fca_abrir_negocio")

  ultimoEventoEm DateTime? @map("fca_ultimo_evento_em")
  totalRecebido  Int       @default(0) @map("fca_total_recebido")
  totalRecusado  Int       @default(0) @map("fca_total_recusado")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventos CaptacaoEvento[]

  @@index([tenantId, ativa])
  @@map("tb_fonte_captacao")
}

/**
 * O que chegou em cada chamada do webhook, cru.
 *
 * GUARDAR O PAYLOAD BRUTO NÃO É LUXO. Portal muda o formato do corpo sem
 * avisar, e o sintoma é "paramos de receber leads do VivaReal" três dias
 * depois. Sem o corpo original não há como descobrir o que mudou — e o lead
 * daqueles três dias está perdido para sempre. Com ele, dá para consertar o
 * leitor e reprocessar.
 *
 * Fica 90 dias e a faxina apaga: é diagnóstico, não acervo.
 */
model CaptacaoEvento {
  id       String @id @default(cuid()) @map("cev_id")
  tenantId String @map("tenant_id")
  fonteId  String @map("fca_id")

  payload Json @map("cev_payload")
  /** ACEITO | RECUSADO | DUPLICADO | ERRO */
  status String  @default("ACEITO") @map("cev_status")
  erro   String? @map("cev_erro") @db.Text

  leadId    String? @map("lea_id")
  negocioId String? @map("neg_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fonte  FonteCaptacao @relation(fields: [fonteId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([fonteId, createdAt])
  @@map("tb_captacao_evento")
}

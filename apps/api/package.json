{
  "name": "@omnimob/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/com-env.mjs -- node --watch src/server.js",
    "postinstall": "prisma generate",
    "start": "node src/server.js",
    "build": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node ../../scripts/com-env.mjs -- prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "node ../../scripts/com-env.mjs -- prisma migrate status",
    "prisma:baseline": "prisma migrate resolve --applied 0_init",
    "prisma:push": "node ../../scripts/com-env.mjs -- prisma db push --skip-generate",
    "prisma:seed": "node ../../scripts/com-env.mjs -- node prisma/seed.js",
    "prisma:seed:dev": "node ../../scripts/com-env.mjs -- node prisma/seed.js --dev",
    "faxina": "node ../../scripts/com-env.mjs -- node scripts/faxina.js",
    "simular:vencimento": "node ../../scripts/com-env.mjs -- node scripts/simular-vencimento.js",
    "status:apagar": "node ../../scripts/com-env.mjs -- node scripts/apagar-status-whatsapp.js",
    "relatorio": "node ../../scripts/com-env.mjs -- node scripts/relatorio-mensal.js",
    "avisos": "node ../../scripts/com-env.mjs -- node scripts/avisos-vencimento.js",
    "leads-parados": "node ../../scripts/com-env.mjs -- node scripts/leads-parados.js",
    "stripe:limpar": "node ../../scripts/com-env.mjs -- node scripts/stripe-limpar.js",
    "subdominios": "node ../../scripts/com-env.mjs -- node scripts/subdominios.js",
    "test": "node ../../scripts/com-env.mjs -- node --test \"test/*.test.js\"",
    "test:isolamento": "node ../../scripts/com-env.mjs -- node --test test/isolamento.test.js",
    "conferir-nomes": "node ../web/scripts/conferir-imports.mjs src",
    "modulos": "node ../../scripts/com-env.mjs -- node scripts/modulos.js",
    "demonstracao": "node ../../scripts/com-env.mjs -- node scripts/demonstracao.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "fast-xml-parser": "^5.11.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^6.5.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}

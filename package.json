{
  "name": "omnimob",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "motion": "^13.1.0",
    "nodemailer": "^9.0.5",
    "ogl": "^1.0.11",
    "three": "^0.185.1",
    "vanta": "^0.5.24"
  }
}
